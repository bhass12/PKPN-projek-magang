.hero {
  padding: 48px 7% 90px;
  margin-top: 0;

}

.laut {
  min-height: 100vh;
  position: absolute;
  z-index: -1;
  top: 0;
  right: 0;
}

.hero h3 {
  font-size: 20px;
  color: #A3F2DD;
  font-weight: lighter;
  text-shadow: 0 0 3px #A3F2DD;
}

.hero h1 {
  font-size: 48px;
  color: #f4f5f5;
  margin-top: 10px;
  max-width: 650px;
}

.hero p {
  font-size: 20px;
  color: #f4f5f5;
  max-width: 800px;
  margin-top: 20px;
}

.hero .kiri {
  margin-right: 20px;
  padding: 15px 30px;
  letter-spacing: 1px;
}

.hero .kanan {
  background-color: #a3f2dd00;
  color: #feffff;
  border: 1px solid #f9fbfb;
  padding: 15px 30px;
  letter-spacing: 1px;
}

.hero a {
  display: inline-block;
  margin-top: 30px;
  padding: 10px 20px;
  background-color: #116A5A;
  color: #fff;
  text-decoration: none;
  border-radius: 5px;
}


.beranda2 {
  position: relative;
  min-height: 50vh;

}

.container-utama {
  padding-top: 100px;

}

.container1 {
  display: flex;
  justify-content: space-between;
  margin: 20px 4%;
  border-radius: 25px;
  gap: 50px;
  padding: 20px;
  background-color: #F4F4ED;
  box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.25);
  margin-bottom: 70px;
}

.box {
  width: 300px;
  padding: 20px;

  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 15px;
}

.icon {
  font-size: 60px;
  object-fit: cover;

}

.box h1 {
  font-size: 20px;
  text-align: center;

}

.box p {
  font-size: 16px;
  text-align: center;
}


/* PUBLIKASI */
.publikasi-section {
  width: 100%;
  padding: 80px 5%;
  box-sizing: border-box;
  background: #f8faf8;
}

.publikasi-container {
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
}

.publikasi-header {
  margin-bottom: 35px;
}

.publikasi-label {
  display: inline-block;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 1.5px;
  color: #117865;
  margin-bottom: 12px;
}

.publikasi-header h2 {
  margin: 0;
  max-width: 650px;
  font-size: clamp(36px, 4vw, 58px);
  line-height: 1.08;
  color: #0d2940;
}

.publikasi-header p {
  max-width: 650px;
  margin-top: 18px;
  font-size: 16px;
  line-height: 1.7;
  color: #5d6b78;
}


/* ========================================
   CARD WRAPPER
======================================== */

.publikasi-wrapper {
  position: relative;
  width: 100%;
}


/* ========================================
   CARD CONTAINER
======================================== */

.publikasi-container-card {
  display: flex;
  gap: 24px;
  width: 100%;
  overflow-x: auto;
  scroll-behavior: smooth;
  scroll-snap-type: x mandatory;
  padding: 5px 3px 15px;
  box-sizing: border-box;
  scrollbar-width: none;
}

.publikasi-container-card::-webkit-scrollbar {
  display: none;
}


/* ========================================
   CARD
======================================== */

.publikasi-card {
  flex: 0 0 calc((100% - 48px) / 3);
  min-width: 0;
  background: #ffffff;
  border: 1px solid rgba(13, 41, 64, 0.10);
  border-radius: 14px;
  overflow: hidden;
  scroll-snap-align: start;
  box-shadow:
    0 8px 25px rgba(13, 41, 64, 0.06);
  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}

.publikasi-card:hover {
  transform: translateY(-7px);
  border-color: rgba(17, 120, 101, 0.35);
  box-shadow:
    0 15px 35px rgba(13, 41, 64, 0.12);
}


/* ========================================
   IMAGE
======================================== */

.publikasi-image {
  position: relative;
  width: 100%;
  height: 250px;
  overflow: hidden;
  background: #e9eeee;
}

.publikasi-image img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition:
    transform 0.5s ease;
}

.publikasi-card:hover .publikasi-image img {
  transform: scale(1.05);
}


/* ========================================
   ICON
======================================== */

.publikasi-icon {
  position: absolute;
  top: 16px;
  left: 16px;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  color: #117865;
  font-size: 24px;
  box-shadow:
    0 5px 15px rgba(0, 0, 0, 0.10);
  backdrop-filter: blur(5px);
}


/* ========================================
   CONTENT
======================================== */

.publikasi-content {
  display: flex;
  flex-direction: column;
  min-height: 225px;
  padding: 24px 22px 18px;
  box-sizing: border-box;
}

.publikasi-content h3 {
  margin: 0;
  font-size: 23px;
  line-height: 1.4;
  color: #0d2940;
  font-weight: 700;
}


/* ========================================
   FOOTER CARD
======================================== */

.publikasi-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-top: auto;
  padding-top: 20px;
  border-top:
    1px solid rgba(13, 41, 64, 0.10);
}


/* ========================================
   DATE
======================================== */

.publikasi-date {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #687684;
  font-size: 14px;
  white-space: nowrap;
}

.publikasi-date iconify-icon {
  color: #117865;
  font-size: 18px;
}


/* ========================================
   DETAIL
======================================== */

.publikasi-detail {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  text-decoration: none;
  color: #117865;
  font-size: 14px;
  font-weight: 700;
  white-space: nowrap;
  transition:
    gap 0.25s ease,
    color 0.25s ease;
}

.publikasi-detail iconify-icon {
  font-size: 18px;
  transition:
    transform 0.25s ease;
}

.publikasi-detail:hover {
  color: #0d2940;
  gap: 10px;
}

.publikasi-detail:hover iconify-icon {
  transform: translate(2px,
      -2px);
}


/* ========================================
   ARROW BUTTON
======================================== */

.publikasi-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 5;
  width: 46px;
  height: 46px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(13, 41, 64, 0.12);
  border-radius: 50%;
  background: #ffffff;
  color: #117865;
  font-size: 21px;
  cursor: pointer;
  box-shadow:
    0 5px 18px rgba(0, 0, 0, 0.10);
  transition:
    transform 0.25s ease,
    background 0.25s ease,
    color 0.25s ease;
}

.publikasi-arrow:hover {
  transform:
    translateY(-50%) scale(1.08);
  background: #117865;
  color: #ffffff;
}


/* POSISI ARROW */

.publikasi-prev {
  left: -23px;
}

.publikasi-next {
  right: -23px;
}


/* ========================================
   DOT
======================================== */

.publikasi-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 25px;
}

.publikasi-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #cbd6d3;
  transition:
    width 0.25s ease,
    background 0.25s ease;
}

.publikasi-dot.active {
  width: 25px;
  border-radius: 10px;
  background: #117865;
}